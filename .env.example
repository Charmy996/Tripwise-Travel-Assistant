# TripWise AI — Environment Variables Overview

# ==============================================================================
# BACKEND (.env in /backend)
# ==============================================================================
# AI Provider configuration (leave LLM_API_KEY blank to use local demo mode)
LLM_PROVIDER=local_demo
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15.0

# Optional Live Information Verification Adapter
LIVE_VERIFICATION_ENABLED=false
LIVE_ADVISORY_ENDPOINT=
LIVE_WEATHER_ENDPOINT=
LIVE_TIMEOUT_SECONDS=5.0

# Hybrid Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
USE_NEURAL_EMBEDDINGS=true

# Allowed CORS origins (comma-separated, or * for public access)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Server Port
PORT=8000

# ==============================================================================
# FRONTEND (.env in /frontend or Vercel Environment Variables)
# ==============================================================================
# Base URL for backend API calls.
# Blank defaults to '/api' (proxied to localhost:8000 by Vite dev server).
# On Vercel, set to your deployed backend URL, e.g.:
# VITE_API_BASE_URL=https://your-tripwise-api.onrender.com/api
VITE_API_BASE_URL=
