# TripWise AI Backend Environment Configuration
# Leave LLM_API_KEY empty to run in local deterministic demonstration mode (no paid API required)
LLM_PROVIDER=local_demo
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15.0

# Optional Live Information Verification Adapter
LIVE_VERIFICATION_ENABLED=false
LIVE_ADVISORY_ENDPOINT=
LIVE_WEATHER_ENDPOINT=
LIVE_TIMEOUT_SECONDS=5.0

# Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
USE_NEURAL_EMBEDDINGS=true

# CORS Configuration (comma-separated list of allowed origins, or * for public access)
# Examples: http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Server Port (optional, defaults to 8000)
PORT=8000
