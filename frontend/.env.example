# Frontend Environment Configuration
# In local development with Vite dev server proxying /api to http://127.0.0.1:8000,
# you can leave this blank or use /api.
# When deploying frontend to Vercel, set this to your deployed backend URL:
# e.g. VITE_API_BASE_URL=https://tripwise-api.onrender.com/api
VITE_API_BASE_URL=
